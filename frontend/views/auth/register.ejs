<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ReUsePlus — Cadastrar-se</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght=400;500;600;700;800&family=Inter:wght=400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>

  <button class="theme-toggle" onclick="toggleTheme()" id="theme-btn">
    <i class="fas fa-moon" id="theme-icon"></i>
    <span id="theme-label">Modo escuro</span>
  </button>

  <div class="auth-full">

    <div class="auth-full-brand">
      <div class="brand-leaves">
        <svg class="brand-leaf-svg-1" viewBox="0 0 200 260" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M100 10 C60 40, 10 80, 20 160 C30 230, 80 255, 100 250 C120 255, 170 230, 180 160 C190 80, 140 40, 100 10Z" fill="#3d9c5c" opacity="0.7"/>
          <path d="M100 10 C100 10, 100 250, 100 250" stroke="#2d7a47" stroke-width="2" opacity="0.5"/>
          <path d="M100 60 C80 80, 65 100, 70 130" stroke="#2d7a47" stroke-width="1.5" opacity="0.4" fill="none"/>
          <path d="M100 60 C120 80, 135 100, 130 130" stroke="#2d7a47" stroke-width="1.5" opacity="0.4" fill="none"/>
        </svg>
        <svg class="brand-leaf-svg-2" viewBox="0 0 180 240" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M90 10 C50 35, 5 70, 15 145 C25 210, 75 232, 90 228 C105 232, 155 210, 165 145 C175 70, 130 35, 90 10Z" fill="#4db870" opacity="0.65"/>
          <path d="M90 10 C90 10, 90 228, 90 228" stroke="#3a9558" stroke-width="2" opacity="0.45"/>
        </svg>
      </div>

      <div class="brand-logo-row">
        <div class="brand-logo-icon"><i class="fas fa-recycle"></i></div>
        <span class="brand-logo-name">ReUsePlus</span>
      </div>

      <div class="brand-hero">
        <div class="brand-hero-eyebrow">
          <i class="fas fa-leaf"></i>
          Plataforma sustentável
        </div>
        <h1>Junte-se à<br><span>comunidade!</span></h1>
        <p>Crie sua conta e comece a<br>fazer a diferença hoje.</p>
      </div>

      <div class="brand-features">
        <div class="brand-feature-item">
          <div class="brand-feature-icon"><i class="fas fa-recycle"></i></div>
          <div>
            <strong>Sustentabilidade</strong>
            <p>Pequenas atitudes, grande impacto.</p>
          </div>
        </div>
        <div class="brand-feature-item">
          <div class="brand-feature-icon"><i class="fas fa-exchange-alt"></i></div>
          <div>
            <strong>Trocas simples</strong>
            <p>Doe, troque e reutilize com facilidade.</p>
          </div>
        </div>
        <div class="brand-feature-item">
          <div class="brand-feature-icon"><i class="fas fa-users"></i></div>
          <div>
            <strong>Comunidade</strong>
            <p>Conecte-se com quem compartilha do mesmo propósito.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="auth-full-form">
      <div class="auth-card">
        <div class="auth-card-icon">
          <i class="fas fa-seedling"></i>
        </div>
        <h2>Crie sua conta</h2>
        <p>Junte-se à nossa comunidade sustentável.</p>

        <form action="/register" method="POST">
          <div class="form-group">
            <label for="reg-nome">Nome completo</label>
            <div class="input-wrap">
              <i class="fas fa-user input-left-icon"></i>
              <input type="text" id="reg-nome" name="nome" placeholder="Seu nome" autocomplete="name">
            </div>
          </div>

          <div class="form-group">
            <label for="reg-email">E-mail</label>
            <div class="input-wrap">
              <i class="fas fa-envelope input-left-icon"></i>
              <input type="email" id="reg-email" name="email" placeholder="seu@email.com" autocomplete="email">
            </div>
          </div>

          <div class="form-group">
            <label for="reg-senha">Senha</label>
            <div class="input-wrap">
              <i class="fas fa-lock input-left-icon"></i>
              <input type="password" id="reg-senha" name="senha" placeholder="••••••••" autocomplete="new-password" oninput="checkStrength(this.value)">
              <button class="input-right-btn" type="button" onclick="togglePass('reg-senha', this)" tabindex="-1">
                <i class="fas fa-eye-slash"></i>
              </button>
            </div>
            <div class="strength-bar" id="strength-bar">
              <div class="strength-bar-seg" id="seg1"></div>
              <div class="strength-bar-seg" id="seg2"></div>
              <div class="strength-bar-seg" id="seg3"></div>
              <div class="strength-bar-seg" id="seg4"></div>
              <span class="strength-label" id="strength-label"></span>
            </div>
          </div>

          <button class="btn-primary" type="submit">
            <i class="fas fa-user-plus"></i> Criar conta
          </button>
        </form>

        <div class="auth-divider">ou</div>

        <button class="btn-google" type="button">
          <svg class="google-icon" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          Cadastrar com Google
        </button>

        <div class="auth-link">
          Já tem conta? <a href="/login">Faça login</a>
        </div>
      </div>
    </div>

  </div>

  <script>
    // ── Theme toggle ──
    let dark = true;
    function toggleTheme() {
      dark = !dark;
      document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
      document.getElementById('theme-icon').className = dark ? 'fas fa-moon' : 'fas fa-sun';
      document.getElementById('theme-label').textContent = dark ? 'Modo escuro' : 'Modo claro';
    }

    // ── Show/hide password ──
    function togglePass(inputId, btn) {
      const input = document.getElementById(inputId);
      const icon  = btn.querySelector('i');
      if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'fas fa-eye';
      } else {
        input.type = 'password';
        icon.className = 'fas fa-eye-slash';
      }
    }

    // ── Password strength ──
    function checkStrength(val) {
      const segs  = [document.getElementById('seg1'), document.getElementById('seg2'),
                     document.getElementById('seg3'), document.getElementById('seg4')];
      const label = document.getElementById('strength-label');

      let score = 0;
      if (val.length >= 6)  score++;
      if (val.length >= 10) score++;
      if (/[A-Z]/.test(val) && /[0-9]/.test(val)) score++;
      if (/[^A-Za-z0-9]/.test(val)) score++;

      const classes = ['', 'weak', 'medium', 'medium', 'strong'];
      const labels  = ['', 'Fraca', 'Média', 'Boa', 'Forte'];
      const cls = score === 0 ? '' : score <= 1 ? 'weak' : score <= 3 ? 'medium' : 'strong';

      segs.forEach((s, i) => {
        s.className = 'strength-bar-seg';
        if (val.length > 0 && i < score) s.classList.add(cls);
      });

      label.textContent = val.length > 0 ? labels[score] || 'Forte' : '';
      label.style.color = cls === 'weak' ? '#e05555' : cls === 'medium' ? '#e0a055' : cls === 'strong' ? '#5db87a' : '';
    }
  </script>
</body>
</html>