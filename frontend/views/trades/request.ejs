<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Solicitar Troca — ReUsePlus</title>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    .item-selector-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 12px;
      margin-top: 12px;
    }
    .item-selector-card {
      border: 2px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 12px;
      cursor: pointer;
      transition: var(--transition-smooth);
      background: #fff;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .item-selector-card:hover {
      border-color: var(--color-accent);
      box-shadow: 0 0 0 3px rgba(82,183,136,0.12);
    }
    .item-selector-card.selected {
      border-color: var(--color-primary);
      background: var(--color-primary-light);
      box-shadow: 0 0 0 3px rgba(45,106,79,0.15);
    }
    .item-selector-card.selected .item-sel-name {
      color: var(--color-primary-dark);
    }
    .item-sel-img {
      width: 100%;
      height: 90px;
      background: var(--bg-main);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      font-size: 24px;
      color: #b0c4b1;
    }
    .item-sel-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .item-sel-name {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-main);
      line-height: 1.3;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .item-sel-estado {
      font-size: 11px;
      color: var(--text-muted);
    }
    .item-sel-check {
      display: none;
      position: absolute;
      top: 8px;
      right: 8px;
      background: var(--color-primary);
      color: #fff;
      border-radius: 50%;
      width: 20px;
      height: 20px;
      align-items: center;
      justify-content: center;
      font-size: 11px;
    }
    .item-selector-card.selected .item-sel-check {
      display: flex;
    }
    .item-selector-card {
      position: relative;
    }

    /* Preview da troca */
    .trade-preview {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 20px;
      background: var(--bg-main);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-color);
      margin: 8px 0 20px;
      flex-wrap: wrap;
    }
    .trade-preview-item {
      flex: 1;
      min-width: 140px;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .trade-preview-img {
      width: 56px;
      height: 56px;
      border-radius: 10px;
      background: #fff;
      border: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      color: #b0c4b1;
      overflow: hidden;
      flex-shrink: 0;
    }
    .trade-preview-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .trade-preview-arrow {
      font-size: 22px;
      color: var(--color-primary);
      flex-shrink: 0;
    }
    .trade-preview-label {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 3px;
    }
    .trade-preview-name {
      font-size: 14px;
      font-weight: 700;
      color: var(--text-main);
    }
    .trade-preview-owner {
      font-size: 12px;
      color: var(--text-muted);
    }

    /* Spinner de loading */
    .loading-itens {
      text-align: center;
      padding: 32px;
      color: var(--text-muted);
    }
  </style>
</head>
<body>
  <div class="layout">
    <%- include('../partials/sidebar', { page: 'trades', usuario: usuario }) %>
    <div class="main-content">
      <nav class="navbar">
        <span class="page-title">
          <a href="/trades" style="color:var(--text-muted); text-decoration:none; font-weight:500;">Trocas</a>
          <i class="fas fa-chevron-right" style="font-size:11px; margin:0 6px; color:var(--text-muted);"></i>
          Solicitar Troca
        </span>
        <div class="navbar-right">
          <button class="notif-btn" aria-label="Notificações" onclick="window.location.href='/trades?filtro=pendente'">
            <i class="fas fa-bell"></i>
            <span class="notif-badge" id="notif-badge"></span>
          </button>
          <div class="user-chip" onclick="window.location.href='/profile'" style="cursor:pointer;">
            <div class="avatar"><%= usuario.nome.charAt(0).toUpperCase() %></div>
            <span><%= usuario.nome %></span>
          </div>
          <a href="/logout" class="btn-logout"><i class="fas fa-sign-out-alt"></i> Sair</a>
        </div>
      </nav>

      <div class="content">
        <div class="panel" style="max-width:760px;">

          <div class="panel-header">
            <div>
              <h3>Solicitar Troca</h3>
              <div class="panel-sub">Escolha um dos seus itens para oferecer em troca</div>
            </div>
            <a href="javascript:history.back()" class="card-link"><i class="fas fa-arrow-left"></i> Voltar</a>
          </div>

          <!-- Mensagem de erro global -->
          <div id="msg-erro" style="display:none; margin-bottom:16px;" class="alert-erro">
            <i class="fas fa-circle-exclamation"></i>
            <span id="msg-erro-texto"></span>
          </div>

          <!-- Preview da troca -->
          <div class="trade-request-label" style="font-size:12px; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:8px;">
            Resumo da troca
          </div>
          <div class="trade-preview">
            <div class="trade-preview-item">
              <div class="trade-preview-img" id="prev-meu-img">
                <i class="fas fa-question"></i>
              </div>
              <div>
                <div class="trade-preview-label">Você oferece</div>
                <div class="trade-preview-name" id="prev-meu-nome">Selecione abaixo</div>
                <div class="trade-preview-owner" id="prev-meu-estado"></div>
              </div>
            </div>

            <div class="trade-preview-arrow">
              <i class="fas fa-arrows-rotate"></i>
            </div>

            <div class="trade-preview-item">
              <div class="trade-preview-img" id="prev-deles-img">
                <i class="fas fa-box"></i>
              </div>
              <div>
                <div class="trade-preview-label">Você deseja</div>
                <div class="trade-preview-name" id="prev-deles-nome">Carregando...</div>
                <div class="trade-preview-owner" id="prev-deles-dono"></div>
              </div>
            </div>
          </div>

          <!-- Selecionar item próprio -->
          <div class="trade-request-label" style="font-size:12px; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:4px; margin-top:8px;">
            Seus itens disponíveis
          </div>
          <div id="meus-itens-container">
            <div class="loading-itens">
              <i class="fas fa-spinner fa-spin" style="font-size:24px; color:#d8f3dc; display:block; margin-bottom:10px;"></i>
              Carregando seus itens...
            </div>
          </div>

          <!-- Mensagem opcional + botão enviar -->
          <div style="margin-top:24px; border-top:1px solid var(--border-color); padding-top:24px;">
            <div class="form-group">
              <label style="font-size:14px; font-weight:600; color:var(--text-main); margin-bottom:8px; display:block;">
                Mensagem para o proprietário <span style="color:var(--text-muted); font-weight:400;">(opcional)</span>
              </label>
              <textarea id="input-mensagem" rows="3" placeholder="Explique por que você quer esse item, ou qualquer detalhe sobre a troca..."
                style="width:100%; box-sizing:border-box; padding:12px; border:1.5px solid var(--border-color); border-radius:var(--radius-md); font-family:'DM Sans',sans-serif; font-size:14px; resize:vertical; outline:none; transition:border 0.2s;"
                onfocus="this.style.borderColor='var(--color-primary)'"
                onblur="this.style.borderColor='var(--border-color)'"></textarea>
            </div>

            <button id="btn-enviar" class="btn-invite" style="width:100%; justify-content:center; opacity:0.5; cursor:not-allowed;" disabled onclick="enviarSolicitacao()">
              <i class="fas fa-paper-plane"></i> Enviar Solicitação
            </button>
            <p id="btn-hint" style="text-align:center; font-size:12px; color:var(--text-muted); margin-top:8px;">
              Selecione um dos seus itens para continuar
            </p>
          </div>

        </div>
      </div>
    </div>
  </div>

  <script>
    const itemDesejadoId = new URLSearchParams(window.location.search).get('item');
    let itemSelecionadoId = null;
    let itemDesejadoDados = null;

    // Notif badge
    fetch('/api/notifications/count').then(r => r.json()).then(d => {
      if (d.count > 0) {
        const b = document.getElementById('notif-badge');
        if (b) { b.textContent = d.count > 9 ? '9+' : d.count; b.classList.add('show'); }
      }
    }).catch(() => {});

    // Carrega o item desejado para mostrar no preview
    async function carregarItemDesejado() {
      if (!itemDesejadoId) {
        document.getElementById('prev-deles-nome').textContent = 'Item não especificado';
        return;
      }
      try {
        const res = await fetch(`/api/items/${itemDesejadoId}`);
        if (!res.ok) throw new Error();
        itemDesejadoDados = await res.json();

        document.getElementById('prev-deles-nome').textContent = itemDesejadoDados.titulo;
        document.getElementById('prev-deles-dono').textContent = itemDesejadoDados.dono?.nome || '';

        const imgEl = document.getElementById('prev-deles-img');
        if (itemDesejadoDados.imagem_url) {
          imgEl.innerHTML = `<img src="${itemDesejadoDados.imagem_url}" onerror="this.outerHTML='<i class=\\'fas fa-box\\'></i>'">`;
        } else {
          imgEl.innerHTML = `<i class="fas fa-box"></i>`;
        }
      } catch {
        document.getElementById('prev-deles-nome').textContent = 'Item não encontrado';
      }
    }

    // Carrega meus itens disponíveis
    async function carregarMeusItens() {
      const container = document.getElementById('meus-itens-container');
      try {
        const res = await fetch('/api/items/meus');
        if (!res.ok) throw new Error();
        const itens = await res.json();
        const disponiveis = itens.filter(i => i.disponivel);

        if (disponiveis.length === 0) {
          container.innerHTML = `
            <div class="empty-state" style="padding:32px 0; border:2px dashed #d8f3dc; border-radius:12px;">
              <i class="fas fa-box" style="font-size:36px; color:#d8f3dc; margin-bottom:12px;"></i>
              <p>Você não tem itens disponíveis</p>
              <span>Cadastre um item antes de solicitar uma troca.</span>
              <a href="/items/create" class="card-link" style="margin-top:16px;">
                Cadastrar item <i class="fas fa-arrow-right"></i>
              </a>
            </div>`;
          return;
        }

        container.innerHTML = `<div class="item-selector-grid">${
          disponiveis.map(i => `
            <div class="item-selector-card" id="card-${i.id}" onclick="selecionarItem(${i.id}, '${escapar(i.titulo)}', '${escapar(i.imagem_url || '')}', '${escapar(i.estado)}')">
              <div class="item-sel-check"><i class="fas fa-check"></i></div>
              <div class="item-sel-img">
                ${i.imagem_url
                  ? `<img src="${i.imagem_url}" onerror="this.outerHTML='<i class=\\'fas fa-image\\'></i>'">`
                  : `<i class="fas fa-image"></i>`}
              </div>
              <div class="item-sel-name">${i.titulo}</div>
              <div class="item-sel-estado">${i.estado.charAt(0).toUpperCase() + i.estado.slice(1)}</div>
            </div>
          `).join('')
        }</div>`;
      } catch {
        container.innerHTML = `
          <div class="alert-erro">
            <i class="fas fa-circle-exclamation"></i> Erro ao carregar seus itens.
          </div>`;
      }
    }

    function escapar(s) {
      return String(s).replace(/'/g, "\\'").replace(/"/g, '\\"');
    }

    function selecionarItem(id, nome, imgUrl, estado) {
      // Desmarca anterior
      document.querySelectorAll('.item-selector-card').forEach(c => c.classList.remove('selected'));
      document.getElementById('card-' + id).classList.add('selected');
      itemSelecionadoId = id;

      // Atualiza preview
      document.getElementById('prev-meu-nome').textContent = nome;
      document.getElementById('prev-meu-estado').textContent = estado.charAt(0).toUpperCase() + estado.slice(1);
      const imgEl = document.getElementById('prev-meu-img');
      if (imgUrl) {
        imgEl.innerHTML = `<img src="${imgUrl}" onerror="this.outerHTML='<i class=\\'fas fa-image\\'></i>'">`;
      } else {
        imgEl.innerHTML = `<i class="fas fa-image"></i>`;
      }

      // Habilita botão
      const btn = document.getElementById('btn-enviar');
      btn.disabled = false;
      btn.style.opacity = '1';
      btn.style.cursor = 'pointer';
      document.getElementById('btn-hint').style.display = 'none';
    }

    async function enviarSolicitacao() {
      if (!itemSelecionadoId || !itemDesejadoId) return;

      const btn = document.getElementById('btn-enviar');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enviando...';

      const mensagem = document.getElementById('input-mensagem').value.trim();

      try {
        const res = await fetch('/api/trades', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            item_oferecido_id: itemSelecionadoId,
            item_desejado_id: itemDesejadoId,
            mensagem: mensagem || null
          })
        });

        if (res.ok) {
          window.location.href = '/trades?sucesso=1';
        } else {
          const d = await res.json();
          document.getElementById('msg-erro-texto').textContent = d.erro || 'Erro ao enviar solicitação.';
          document.getElementById('msg-erro').style.display = 'flex';
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-paper-plane"></i> Enviar Solicitação';
        }
      } catch {
        document.getElementById('msg-erro-texto').textContent = 'Erro de conexão. Tente novamente.';
        document.getElementById('msg-erro').style.display = 'flex';
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-paper-plane"></i> Enviar Solicitação';
      }
    }

    carregarItemDesejado();
    carregarMeusItens();
  </script>
</body>
</html>
