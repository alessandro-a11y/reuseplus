<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Solicitar Troca — ReUsePlus</title>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>
  <div class="layout">
    <%- include('../partials/sidebar', { page: 'trades', usuario: usuario }) %>
    <div class="main-content">
      <nav class="navbar">
        <span class="page-title">Solicitar Troca</span>
        <div class="navbar-right">
          <button class="notif-btn"><i class="fas fa-bell"></i><span class="dot"></span></button>
          <div class="user-chip">
            <div class="avatar"><%= usuario.nome.charAt(0).toUpperCase() %></div>
            <span><%= usuario.nome %></span>
          </div>
          <a href="/logout" class="btn-logout"><i class="fas fa-sign-out-alt"></i> Sair</a>
        </div>
      </nav>
      <div class="content">

        <div class="panel" style="max-width: 700px;">
          <div class="panel-header">
            <div>
              <h3>Solicitar Troca</h3>
              <div class="panel-sub">Escolha um dos seus itens para oferecer em troca</div>
            </div>
            <a href="/items" class="card-link"><i class="fas fa-arrow-left"></i> Voltar</a>
          </div>

          <div class="trade-request-item">
            <div class="trade-request-label">Item desejado</div>
            <div class="trade-item-card">
              <div class="item-image-placeholder" style="width:80px; height:80px; font-size:24px;">
                <i class="fas fa-image"></i>
              </div>
              <div>
                <strong>Nome do Item</strong>
                <span>Proprietário: Usuário</span>
                <div class="item-status-badge disponivel">Disponível</div>
              </div>
            </div>
          </div>

          <div class="trade-arrow">
            <i class="fas fa-arrows-rotate"></i>
          </div>

          <div class="trade-request-item">
            <div class="trade-request-label">Seu item para oferecer</div>
            <div class="empty-state" style="padding: 24px; border: 2px dashed #d8f3dc; border-radius: 12px;">
              <i class="fas fa-box" style="font-size:32px; color:#d8f3dc; margin-bottom:10px;"></i>
              <p style="font-size:14px;">Selecione um item</p>
              <span>Escolha qual item você quer oferecer</span>
            </div>
          </div>

          <form action="/trades" method="POST" style="margin-top: 24px;">
            <div class="form-group">
              <label>Mensagem para o proprietário (opcional)</label>
              <textarea name="mensagem" rows="3" placeholder="Explique por que você quer esse item..."></textarea>
            </div>
            <button type="submit" class="btn-invite" style="width:100%; justify-content:center;">
              <i class="fas fa-paper-plane"></i> Enviar Solicitação
            </button>
          </form>

        </div>

      </div>
    </div>
  </div>
</body>
</html>